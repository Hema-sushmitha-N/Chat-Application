PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chatsphere
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Optional performance / protection settings (defaults shown)
# RATE_LIMIT_API=600      requests per minute per IP address
# RATE_LIMIT_AUTH=50      login + register attempts per 15 minutes per IP address
# DB_POOL_SIZE=20         MongoDB connections kept open
